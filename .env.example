# Copy file nay thanh .env va dien key that:
#   cp .env.example .env
#
# LUU Y (README muc 9.4): chi de API key / endpoint o day.
# TEN MODEL PHAI KHAI BAO TRONG SOURCE CODE va logging/metadata.json,
# KHONG dat trong .env - giam khao can doc duoc ten model tu code.

# Endpoint OpenAI-compatible. Chon 1 trong cac vi du duoi:
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://localhost:8000/v1
LLM_BASE_URL=

# API key cua provider tuong ung. Neu chay Ollama/vLLM local thi dien tam: ollama
LLM_API_KEY=
